---
import { nav, profile } from '../data/site.js';
import T from './T.astro';
---

<nav class="nav">
  <div class="wrap nav-in">
    <a href="#top" class="nav-brand">{profile.name}</a>

    <div class="nav-links">
      {
        nav.map((n) => (
          <a href={`#${n.id}`}>
            <T zh={n.zh} en={n.en} />
          </a>
        ))
      }
    </div>

    <div class="nav-tools">
      <button id="lang-toggle" class="icon-btn" type="button" aria-label="切换语言 / Switch language">
        <span data-l="zh">EN</span><span data-l="en">中</span>
      </button>
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="切换深浅色 / Toggle theme">
        <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<style>
  /* 亮色显示月亮（点了会变暗），暗色显示太阳 */
  .ico-moon { display: none; }
  :global(html[data-theme='dark']) .ico-moon { display: block; }
  :global(html[data-theme='dark']) .ico-sun { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .ico-moon { display: block; }
    :global(html:not([data-theme='light'])) .ico-sun { display: none; }
  }
</style>

<script>
  const root = document.documentElement;

  const store = (k: string, v: string) => {
    try {
      localStorage.setItem(k, v);
    } catch {
      /* 隐私模式下写不进去，切换本次仍然生效 */
    }
  };

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    // 没显式设过就跟随系统，第一次点击从系统当前值的反面开始
    const current =
      root.getAttribute('data-theme') ||
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    store('theme', next);
  });

  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const next = root.getAttribute('data-lang') === 'en' ? 'zh' : 'en';
    root.setAttribute('data-lang', next);
    root.setAttribute('lang', next === 'en' ? 'en' : 'zh-CN');
    store('lang', next);
  });
</script>
